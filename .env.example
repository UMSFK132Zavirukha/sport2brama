# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота від @BotFather
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# ID супергрупи (з мінусом)
# Як дізнатись: переслати повідомлення з групи боту @JsonDumpBot → поле chat.id
GROUP_ID=-1001234567890

# ID гілки (topic) де публікується зайнятість
# Як дізнатись: переслати повідомлення з гілки боту @JsonDumpBot → поле message_thread_id
TOPIC_ID=123

# ── Google Calendar ────────────────────────────────────────────────────────────
# ID календаря: Google Calendar → Налаштування → Інтеграція календаря
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Варіант 1 — вставити credentials.json як рядок (для Railway/Render):
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"booking-bot@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Варіант 2 — шлях до файлу (для локального запуску):
# GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Майданчик ──────────────────────────────────────────────────────────────────
# Години роботи та тривалість слоту (за замовчуванням 8:00–21:00, по 1 год)
WORK_START=8
WORK_END=21
SLOT_DURATION=1
